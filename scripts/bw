#!/usr/bin/env bash
# bw — Brazil Workspace manager
#
# Usage:
#   bw new <branch-name> [workspace-name]   Create a new parallel workspace
#   bw list                                  List all workspaces
#   bw rm <workspace-name>                   Remove a workspace
#   bw rebase <source-workspace>             Rebase current workspace on top of another
#
# Example:
#   bw new feature/asr-mitigations           Creates /workplace/adesain/DailyShopAgent-feature-asr-mitigations/
#   bw new feature/asr-mitigations asr-work  Creates /workplace/adesain/DailyShopAgent-asr-work/
#   bw rebase prompt-data-input-validation   Rebases all packages onto that workspace's branches

set -euo pipefail

# Walk up from $PWD to find the Brazil workspace root (directory containing packageInfo)
_find_workspace_root() {
    local dir="$PWD"
    while [ "$dir" != "/" ]; do
        [ -f "$dir/packageInfo" ] && { echo "$dir"; return; }
        dir="$(dirname "$dir")"
    done
    echo ""
}

WORKSPACE_ROOT="$(_find_workspace_root)"
if [ -z "$WORKSPACE_ROOT" ]; then
    echo "error: not inside a Brazil workspace (no packageInfo found in $PWD or any parent)" >&2
    exit 1
fi
WORKSPACE_PARENT="$(dirname "$WORKSPACE_ROOT")"
WORKSPACE_NAME="$(basename "$WORKSPACE_ROOT")"
SRC_DIR="$WORKSPACE_ROOT/src"

_packages() {
    for d in "$SRC_DIR"/*/; do
        [ -d "$d/.git" ] && basename "$d"
    done
}

_workspace_dir() {
    local branch="$1"
    local alias="${2:-}"
    if [ -n "$alias" ]; then
        echo "$WORKSPACE_PARENT/${WORKSPACE_NAME}-${alias}"
    else
        local slug
        slug=$(echo "$branch" | tr '/' '-' | tr '_' '-')
        echo "$WORKSPACE_PARENT/${WORKSPACE_NAME}-${slug}"
    fi
}

cmd_new() {
    local branch="${1:-}"
    local alias="${2:-}"
    [ -z "$branch" ] && { echo "Usage: bw new <branch-name> [workspace-name]"; exit 1; }

    local dest
    dest="$(_workspace_dir "$branch" "$alias")"

    if [ -d "$dest" ]; then
        echo "error: $dest already exists" >&2
        exit 1
    fi

    echo "Creating workspace: $dest"
    mkdir -p "$dest/src"

    # packageInfo is what Brazil uses to recognize a workspace directory
    if [ -f "$WORKSPACE_ROOT/packageInfo" ]; then
        cp "$WORKSPACE_ROOT/packageInfo" "$dest/packageInfo"
    else
        echo "error: no packageInfo found in $WORKSPACE_ROOT" >&2
        exit 1
    fi

    local failed=0
    for pkg in $(_packages); do
        local src_pkg="$SRC_DIR/$pkg"
        local dst_pkg="$dest/src/$pkg"
        local origin_url
        origin_url=$(git -C "$src_pkg" remote get-url origin)

        echo "  + $pkg (cloning with local reference)"
        # Clone from origin but use local repo as reference for speed (shared objects via hardlink)
        if ! git clone --reference "$src_pkg" --branch mainline "$origin_url" "$dst_pkg" 2>&1; then
            echo "    WARNING: clone failed for $pkg" >&2
            failed=$((failed + 1))
            continue
        fi

        # Create and checkout the feature branch, tracking mainline
        git -C "$dst_pkg" checkout -b "$branch" origin/mainline
        git -C "$dst_pkg" branch --set-upstream-to=origin/mainline "$branch"
    done

    echo ""
    echo "Workspace ready at: $dest"
    echo "Packages cloned: $(echo $(_packages) | wc -w | tr -d ' ')"
    [ "$failed" -gt 0 ] && echo "WARNING: $failed package(s) failed — check output above"
    echo ""
    echo "Next steps:"
    echo "  cd $dest && brazil workspace sync --md"
}

cmd_list() {
    echo "Workspaces (sibling directories matching ${WORKSPACE_NAME}-*):"
    echo ""
    for d in "$WORKSPACE_PARENT/${WORKSPACE_NAME}-"*/; do
        [ -d "$d" ] || continue
        local name
        name=$(basename "$d")
        local suffix="${name#${WORKSPACE_NAME}-}"
        # Show branch of first package as indicator
        local branch="unknown"
        local first_pkg
        first_pkg=$(ls "$d/src/" 2>/dev/null | head -1)
        if [ -n "$first_pkg" ] && [ -d "$d/src/$first_pkg/.git" ]; then
            branch=$(git -C "$d/src/$first_pkg" branch --show-current 2>/dev/null || echo "detached")
        fi
        printf "  %-30s branch: %s\n" "$suffix" "$branch"
    done
}

cmd_rm() {
    local alias="${1:-}"
    [ -z "$alias" ] && { echo "Usage: bw rm <workspace-name>"; exit 1; }

    local dest
    if [[ "$alias" == /* ]]; then
        dest="$alias"
    else
        # Use the base project name (before first -) to build the path
        # so it works regardless of which workspace you're standing in
        local base_name="${WORKSPACE_NAME%%-*}"
        dest="$WORKSPACE_PARENT/${base_name}-${alias}"
        # Fallback: try with full workspace name as prefix
        if [ ! -d "$dest" ]; then
            dest="$WORKSPACE_PARENT/${WORKSPACE_NAME}-${alias}"
        fi
    fi

    if [ ! -d "$dest" ]; then
        echo "error: no workspace found for '$alias'" >&2
        exit 1
    fi

    # Safety: refuse to delete the base workspace
    local base_name="${WORKSPACE_NAME%%-*}"
    if [ "$(basename "$dest")" = "$base_name" ] || [ "$dest" = "$WORKSPACE_ROOT" ]; then
        echo "error: refusing to delete the base workspace" >&2
        exit 1
    fi

    # Safety: must contain packageInfo to be a workspace
    if [ ! -f "$dest/packageInfo" ]; then
        echo "error: $dest does not look like a Brazil workspace (no packageInfo)" >&2
        exit 1
    fi

    echo "Removing workspace: $dest"
    rm -rf "$dest"
    echo "Done."
}

cmd_rebase() {
    local source="${1:-}"
    [ -z "$source" ] && { echo "Usage: bw rebase <source-workspace>"; exit 1; }

    local source_dir
    if [[ "$source" == /* ]]; then
        source_dir="$source"
    else
        local base_name="${WORKSPACE_NAME%%-*}"
        source_dir="$WORKSPACE_PARENT/${base_name}-${source}"
        if [ ! -d "$source_dir" ]; then
            source_dir="$WORKSPACE_PARENT/${WORKSPACE_NAME}-${source}"
        fi
    fi

    if [ ! -d "$source_dir/src" ]; then
        echo "error: $source_dir not found or not a workspace" >&2
        exit 1
    fi

    local remote_name="bw-${source##*/}"
    remote_name="${remote_name//[^a-zA-Z0-9_-]/-}"

    echo "Rebasing current workspace onto: $source_dir"
    echo "Remote name: $remote_name"
    echo ""

    local rebased=0
    local skipped=0
    local failed=0
    local conflicts=()

    for pkg in $(_packages); do
        local our_pkg="$SRC_DIR/$pkg"
        local their_pkg="$source_dir/src/$pkg"

        if [ ! -d "$their_pkg/.git" ]; then
            echo "  ~ $pkg (not in source workspace, skipping)"
            skipped=$((skipped + 1))
            continue
        fi

        echo "  > $pkg"

        # Add or update the remote pointing to the other workspace's local repo
        local their_branch
        their_branch=$(git -C "$their_pkg" branch --show-current 2>/dev/null)

        if git -C "$our_pkg" remote get-url "$remote_name" &>/dev/null; then
            git -C "$our_pkg" remote set-url "$remote_name" "$their_pkg"
        else
            git -C "$our_pkg" remote add "$remote_name" "$their_pkg"
        fi

        # Fetch the remote branch
        if ! git -C "$our_pkg" fetch "$remote_name" "$their_branch" --quiet 2>/dev/null; then
            echo "    FAILED: could not fetch $their_branch from $their_pkg" >&2
            failed=$((failed + 1))
            continue
        fi

        local their_ref="$remote_name/$their_branch"
        local our_head their_head
        our_head=$(git -C "$our_pkg" rev-parse HEAD)
        their_head=$(git -C "$our_pkg" rev-parse "$their_ref")

        if [ "$our_head" = "$their_head" ]; then
            echo "    already up to date"
            skipped=$((skipped + 1))
            continue
        fi

        # Rebase our branch onto theirs, skipping commits already in target
        if git -C "$our_pkg" rebase --no-reapply-cherry-picks "$their_ref" 2>/dev/null; then
            local our_commits
            our_commits=$(git -C "$our_pkg" log --oneline "$their_ref"..HEAD 2>/dev/null | wc -l | tr -d ' ')
            echo "    rebased ($our_commits local commit(s) on top of $their_branch)"
        else
            echo "    CONFLICT — rebase paused"
            conflicts+=("$pkg")
            failed=$((failed + 1))
            continue
        fi
        rebased=$((rebased + 1))
    done

    echo ""
    echo "Done: $rebased rebased, $skipped skipped, $failed failed"

    if [ "${#conflicts[@]}" -gt 0 ]; then
        echo ""
        echo "Resolve conflicts in:"
        for pkg in "${conflicts[@]}"; do
            echo "  cd $SRC_DIR/$pkg"
            echo "    # fix conflicts, git add, git rebase --continue"
            echo ""
        done
        echo "After resolving, you can pull future changes with:"
        echo "  cd <package> && git pull --rebase $remote_name <branch>"
    fi

    echo ""
    echo "Remote '$remote_name' added to all packages."
    echo "Future updates: cd <package> && git pull --rebase $remote_name <branch>"
}

cmd="${1:-help}"
shift || true

case "$cmd" in
    new)    cmd_new "$@" ;;
    list)   cmd_list ;;
    rm)     cmd_rm "$@" ;;
    rebase) cmd_rebase "$@" ;;
    help|--help|-h)
        grep '^# ' "$0" | sed 's/^# //'
        ;;
    *)
        echo "Unknown command: $cmd"
        echo "Run: bw help"
        exit 1
        ;;
esac
