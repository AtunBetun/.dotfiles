#!/usr/bin/env bash
set -euo pipefail

if [[ $# != 1 || -z $1 || $1 == -* || $1 == *[[:space:]]* ]]; then
    printf 'Usage: hherd HOST|ssh://USER@HOST:PORT\n' >&2
    exit 2
fi

export PATH="$HOME/.local/bin:$PATH"

session=${TE:-main}
session=${session//[^A-Za-z0-9._-]/-}

exec env MISE_CEILING_PATHS="$HOME" mise -C "$HOME" exec -- \
    herdr --remote "$1" --session "$session" --remote-keybindings server
