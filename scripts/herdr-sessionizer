#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"
runtime=$(MISE_CEILING_PATHS="$HOME" mise -C "$HOME" env --shell bash)
eval "$runtime"
[[ $# -le 1 ]] || { printf 'Usage: herdr-sessionizer [DIRECTORY]\n' >&2; exit 2; }

if [[ $# == 1 ]]; then
    selected=$1
else
    status=0
    # shortcut: newline-containing directory names are unsupported; use a NUL picker if needed.
    selected=$(fd --type directory --max-depth 3 --color never . "$PWD" | \
        fzf --height=90% --border=sharp --prompt='Open Herdr Space > ') || status=$?
    case $status in
        0) ;;
        1|130) exit 0 ;;
        *) exit "$status" ;;
    esac
fi

[[ -d $selected ]] || { printf 'herdr-sessionizer: not a directory: %s\n' "$selected" >&2; exit 1; }
selected=$(cd -- "$selected" && pwd -P)

existing=$(herdr workspace list | jq -er --arg n "$selected" '
    if (.result.workspaces | type) != "array" then error("Invalid workspace listing")
    else [.result.workspaces[] | select(.label == $n) | .workspace_id][0] // "" end')
if [[ -n $existing ]]; then
    exec herdr workspace focus "$existing"
else
    exec herdr workspace create --cwd "$selected" --label "$selected" --focus
fi
