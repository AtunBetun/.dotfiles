#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"
runtime=$(MISE_CEILING_PATHS="$HOME" mise -C "$HOME" env --shell bash)
eval "$runtime"
[[ $# -le 1 ]] || { printf 'Usage: herdr-sessionizer [DIRECTORY]\n' >&2; exit 2; }

if [[ $# == 1 ]]; then
    selected=$1
else
    status=0
    shopt -s nullglob dotglob
    roots=("$HOME" "$HOME/work" "$HOME/personal" "$HOME/workplace" "/workplace/$(id -un)")
    candidates=()
    # macOS still ships Bash 3.2, which has indexed arrays but no associative arrays.
    seen_roots=()
    for root in "${roots[@]}"; do
        [[ -d $root ]] || continue
        resolved=$(CDPATH= cd -- "$root" && pwd -P)
        seen=false
        for ((i = 0; i < ${#seen_roots[@]}; i++)); do
            if [[ ${seen_roots[i]} == "$resolved" ]]; then
                seen=true
                break
            fi
        done
        [[ $seen == false ]] || continue
        seen_roots+=("$resolved")
        for directory in "$root"/*/; do
            [[ -d $directory ]] || continue
            candidates+=("${directory%/}")
            if [[ $root == "$HOME/workplace" || $root == /workplace/* ]]; then
                for project in "$directory"src/*/; do
                    [[ -d $project ]] && candidates+=("${project%/}")
                done
            fi
        done
    done
    [[ ${#candidates[@]} -gt 0 ]] || { printf 'herdr-sessionizer: no directories found\n' >&2; exit 0; }
    # Directory names containing newlines are unsupported by this picker.
    selected=$(printf '%s\n' "${candidates[@]}" | \
        fzf --height=90% --border=sharp --prompt='Open Herdr Space > ') || status=$?
    case $status in
        0) ;;
        1|130) exit 0 ;;
        *) exit "$status" ;;
    esac
fi

[[ -d $selected ]] || { printf 'herdr-sessionizer: not a directory: %s\n' "$selected" >&2; exit 1; }
selected=$(CDPATH= cd -- "$selected" && pwd -P)
name=${selected##*/}
[[ -n $name ]] || name=/

existing=$(herdr workspace list | jq -er --arg path "$selected" --arg name "$name" '
    if (.result.workspaces | type) != "array" then error("Invalid workspace listing")
    else .result.workspaces |
        (map(select(.label == $path)) + map(select(.label == $name)))[0].workspace_id // ""
    end')
if [[ -n $existing ]]; then
    herdr workspace rename "$existing" "$name" >/dev/null
    exec herdr workspace focus "$existing"
else
    exec herdr workspace create --cwd "$selected" --label "$name" --focus
fi
