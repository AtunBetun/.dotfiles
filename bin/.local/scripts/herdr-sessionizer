#!/usr/bin/env zsh
# Herdr popup panes inherit the server's minimal non-interactive PATH (no
# zshrc, no mise), so add tool locations explicitly: herdr, fzf (mise shim),
# jq (mason), tree (linuxbrew).
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$HOME/.local/share/nvim/mason/bin:/home/linuxbrew/.linuxbrew/bin:$PATH"

setopt null_glob

if [[ $# -eq 1 ]]; then
    selected=$1
else
    selected=$(find ~/work ~/ /workplace/adesain /workplace/adesain/*/src -mindepth 1 -maxdepth 1 -type d 2>/dev/null | fzf --height=90% --border=sharp --prompt='Open Herdr Space > ' --preview='tree -C {}' --preview-window='45%,border-sharp')
fi

[[ -z $selected ]] && exit 0

selected_name=$(basename "$selected" | tr . _)

existing=$(herdr workspace list | jq -r --arg n "$selected_name" \
    '.result.workspaces[] | select(.label == $n) | .workspace_id' | head -1)

if [[ -n $existing ]]; then
    herdr workspace focus "$existing"
else
    herdr workspace create --cwd "$selected" --label "$selected_name" --focus
fi
