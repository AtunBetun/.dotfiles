#!/usr/bin/env bash
set -euo pipefail

repo=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
dry_run=false
case "${1:-}" in
    '') ;;
    --dry-run) dry_run=true; shift ;;
    *) printf 'Usage: %s [--dry-run]\n' "$0" >&2; exit 2 ;;
esac
[[ $# == 0 ]] || { printf 'Unexpected setup arguments\n' >&2; exit 2; }

mise=${MISE_BIN:-$(command -v mise || true)}
[[ -n $mise ]] || mise="$HOME/.local/bin/mise"
[[ -x $mise ]] || { printf 'Install mise 2026.11.0 first; see README.md.\n' >&2; exit 1; }
version=$("$mise" --version)
[[ ${version%% *} == 2026.11.0 ]] || {
    printf 'This setup is tested with mise 2026.11.0; found %s. See README.md.\n' "$version" >&2
    exit 1
}

profile=
case "$(uname -s)" in
    Darwin) ;;
    Linux)
        [[ -r /etc/os-release ]] || { printf 'Cannot identify Linux distribution\n' >&2; exit 1; }
        . /etc/os-release
        [[ ${ID:-} != amzn || ${VERSION_ID:-} != 2 ]] || profile=al2
        ;;
    *) printf 'Supported platforms: macOS and Linux\n' >&2; exit 1 ;;
esac

if [[ $(uname -s) == Linux ]]; then
    for tool in cc curl tar unzip; do
        command -v "$tool" >/dev/null || { printf 'Linux editor setup requires %s; see README.md.\n' "$tool" >&2; exit 1; }
    done
    if [[ $profile == al2 ]]; then
        for tool in cmake make; do
            command -v "$tool" >/dev/null || { printf 'AL2 Neovim source build requires %s; see README.md.\n' "$tool" >&2; exit 1; }
        done
    fi
    if [[ -z ${LIBCLANG_PATH:-} ]]; then
        command -v llvm-config >/dev/null || { printf 'Linux parser build requires native clang-devel/llvm-devel or LIBCLANG_PATH; see README.md.\n' >&2; exit 1; }
        export LIBCLANG_PATH="$(llvm-config --libdir)"
    fi
fi

export MISE_TRUSTED_CONFIG_PATHS="$repo"
export MISE_ENV="$profile"
export MISE_CEILING_PATHS="$(dirname -- "$repo")"
if $dry_run; then
    printf 'Runtime profile: %s; install from committed locks before deployment.\n' "${profile:-upstream}"
    "$mise" -C "$repo" dot apply --dry-run
    exit
fi

# Install before replacing global config; a failed download leaves existing configuration intact.
staging=$(mktemp -d)
trap 'rm -rf -- "$staging"' EXIT
cp "$repo/runtime/common.toml" "$staging/common.toml"
if [[ $profile == al2 ]]; then
    cp "$repo/runtime/config.al2.toml" "$staging/config.toml"
    cp "$repo/runtime/mise.al2.lock" "$staging/mise.lock"
else
    cp "$repo/runtime/config.toml" "$staging/config.toml"
    cp "$repo/runtime/mise.lock" "$staging/mise.lock"
fi
env MISE_CONFIG_DIR="$staging" MISE_CEILING_PATHS="$staging" \
    "$mise" -C "$staging" install --locked
"$mise" -C "$repo" dot apply
"$mise" -C "$repo" dot status --missing
"$mise" trust "${MISE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/mise}/config.toml"
printf 'Dotfiles applied. Run mise run editor-setup, then open a new shell.\n'
if [[ $(uname -s) == Darwin ]]; then
    printf 'Run mise run mac-apps for GUI applications and onboarding.\n'
fi
